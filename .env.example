# Copy to .env and fill in. NEVER commit .env.
FLASK_APP=run.py
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Backend port. The Flutter app defaults to 5050 as well (see README.md).
PORT=5050

# Database. Hosted Postgres (Neon etc.):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# For a throwaway local database while developing/testing:
#   DATABASE_URL=sqlite:///secureshe.db
# The app never alters a shared database by itself; run
#   python scripts/migrate.py --dry-run   (then without --dry-run)
# whenever the models change.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Pinata IPFS: get keys at https://app.pinata.cloud/keys
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-api-key

# Blockchain (Sepolia): fill these in after deploying blockchain/contracts/SecureSheRegistry.sol
WEB3_PROVIDER_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
CONTRACT_ADDRESS=your-deployed-contract-address
BACKEND_WALLET_PRIVATE_KEY=your-test-wallet-private-key
# Optional tuning (defaults shown):
#   CHAIN_GAS_MULTIPLIER=1.3        headroom over the node's gas estimate
#   CHAIN_MAX_GAS=3000000           hard cap; a bigger estimate fails loudly
#   CHAIN_MAX_ATTEMPTS=3            automatic send attempts before "failed"
#   CHAIN_POLL_SECONDS=5            how often the background worker checks receipts
#   CHAIN_WORKER=1                  set 0 to disable the background worker

# Admin status updates (PATCH /api/complaints/<id>/status, header X-Admin-Key).
# Leave empty to disable the endpoint. Use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=

# Browser clients only (Flutter web). Comma-separated origins; empty = CORS off.
CORS_ORIGINS=

# Rate limits (defaults shown). Set RATELIMIT_STORAGE_URI to a Redis URL if you
# ever run more than one worker process.
#   LOGIN_RATE_LIMIT=10 per minute
#   REGISTER_RATE_LIMIT=5 per minute
#   PASSWORD_RATE_LIMIT=5 per minute

# SOS SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+10000000000
